# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/event_db

# Security & JWT
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis Configuration (если используется для кэша или лимитов)
REDIS_URL=redis://redis:6379/0

# Application Settings
DEBUG=True
APP_NAME=EventTicketAPI